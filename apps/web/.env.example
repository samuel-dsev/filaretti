# Local development only. Copy to .env.local; never commit actual environment files.
APP_ENV=development
# Internal API origin stays on the server and must not use a NEXT_PUBLIC_ prefix.
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Reserved for explicit same-origin domain routes from F2 onward; F1 has no forwarding route.
NEXT_PUBLIC_API_BASE_PATH=/api/v1
MOCK_CONTENT=true
NEXT_PUBLIC_MOCK_INTEGRATIONS=true
GA4_ENABLED=false
# Habilitar somente depois de desativar medição automática na propriedade GA4.
GA4_ENHANCED_MEASUREMENT_DISABLED=false
SEO_INDEXING_ENABLED=false
REVALIDATION_SECRET=replace-with-random-revalidation-secret

# Public identifiers only. Keep provider secrets in apps/api environment.
# External providers are pending later phases and no integration is enabled in F1.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_SENTRY_DSN=
# F8: server-only, same key as API. Never use NEXT_PUBLIC_ for this key.
BFF_CLIENT_IP_SECRET=
# Select only after ingress overwrites it and direct origin access is blocked.
WEB_CLIENT_IP_HEADER=
WEB_TRUSTED_PROXY_CONFIRMED=false
