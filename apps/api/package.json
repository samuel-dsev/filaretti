{
  "name": "@filaretti/api",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && tsc-watch --onSuccess \"node dist/main.js\"",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src test prisma scripts",
    "typecheck": "prisma generate && tsc -p tsconfig.test.json --noEmit && tsc -p prisma/tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/foundation.test.js",
    "test:integration": "prisma generate && tsc -p tsconfig.test.json && node scripts/run-integration.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed:development": "tsx prisma/seed-development.ts",
    "db:seed:production": "tsx prisma/seed-production.ts",
    "db:provision-admin": "tsx prisma/provision-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@filaretti/config": "workspace:*",
    "@filaretti/types": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.5",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "svix": "2.6.1"
  },
  "devDependencies": {
    "@filaretti/eslint-config": "workspace:*",
    "@filaretti/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsc-watch": "7.2.0",
    "tsx": "4.23.15"
  }
}
