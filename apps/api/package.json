{
  "name": "@filaretti/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/foundation.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test dist-test/test/health.integration.test.js",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@filaretti/config": "workspace:*",
    "@filaretti/types": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.5",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@filaretti/tsconfig": "workspace:*",
    "@filaretti/eslint-config": "workspace:*",
    "@types/pg": "8.23.1",
    "@types/express": "5.0.6",
    "prisma": "7.10.0",
    "tsc-watch": "7.2.0"
  }
}
