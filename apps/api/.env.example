APP_ENV=development
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgresql://filaretti_dev:replace-with-local-random-password@127.0.0.1:5434/filaretti_dev
DATABASE_TIMEOUT_MS=2000
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
MOCK_CONTENT=true
MOCK_INTEGRATIONS=true
RELATIONSHIP_ENABLED=true
RELATIONSHIP_WORKER_ENABLED=true
CONTACT_RETENTION_DAYS=180
SUBSCRIBER_RETENTION_DAYS=365
PRIVACY_VERSION=development-v1
NEWSLETTER_CONSENT_VERSION=development-v1
CONTACT_NOTIFICATION_EMAIL=contato@example.invalid
# 32 bytes hex no ambiente real; fallback PREVIEW_SECRET derivado somente no mock local.
MAIL_ENCRYPTION_KEY=
MAIL_LOCAL_PATH=../../.local/mail
# Obrigatório em staging real: destinatários autorizados separados por vírgula.
RESEND_TEST_RECIPIENTS=
# Sessão administrativa: segredos server-only; valores reais ficam ignorados.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
JWT_SECRET=replace-with-random-jwt-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_SECRET=replace-with-random-refresh-secret
REFRESH_TOKEN_TTL_SECONDS=604800
PREVIEW_SECRET=replace-with-random-preview-secret
PREVIEW_TTL_SECONDS=900
REVALIDATION_SECRET=replace-with-random-revalidation-secret
REVALIDATION_TIMEOUT_MS=5000
CMS_WORKER_ENABLED=true
# Storage local disponível; R2 real exige configuração/autorização de homologação.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=../../.local/storage
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=
SENTRY_DSN=
