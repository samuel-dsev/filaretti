# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:24.18.0-bookworm-slim

FROM ${NODE_IMAGE} AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:/usr/local/bin:$PATH \
    NEXT_TELEMETRY_DISABLED=1 \
    HUSKY=0
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global --ignore-scripts pnpm@11.25.0
WORKDIR /workspace

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/
COPY infra/vps/build-web.mjs ./infra/vps/build-web.mjs
RUN --mount=type=cache,id=filaretti-vps-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store --network-concurrency 8 --child-concurrency 2
RUN pnpm --filter @filaretti/config build \
    && pnpm --filter @filaretti/types build
# Native Node dotenv loading avoids shell evaluation of private build values.
# The mount never becomes an image layer. Do not pass secrets as build arguments.
RUN --mount=type=secret,id=web_build_env,required=true,target=/run/secrets/web-build.env \
    node infra/vps/build-web.mjs /run/secrets/web-build.env

FROM ${NODE_IMAGE} AS runtime
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.title="Filaretti web" \
      org.opencontainers.image.revision=${SOURCE_COMMIT}
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /app
# Standalone tracing preserves the monorepo paths under apps/web.
COPY --from=build --chown=node:node /workspace/apps/web/.next/standalone/ ./
COPY --from=build --chown=node:node /workspace/apps/web/.next/static/ ./apps/web/.next/static/
COPY --from=build --chown=node:node /workspace/apps/web/public/ ./apps/web/public/
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
