# Replace __TRAEFIK_IP__ only with the inspected proxy container address.
# No host port is published; only the existing proxy reaches this entry point.
log_format filaretti_safe '$remote_addr via=$realip_remote_addr $request_method status=$status';
geo $realip_remote_addr $filaretti_proxy_allowed {
    default 0;
    __TRAEFIK_IP__ 1;
}

server {
    listen 8080;
    server_name ettorifilaretti.adv.br;
    server_tokens off;
    access_log /var/log/nginx/access.log filaretti_safe;
    error_log /dev/stderr error;
    client_max_body_size 12m;
    set_real_ip_from __TRAEFIK_IP__;
    # The existing Traefik accepts forwarded headers. Use its appended socket
    # peer at the right of XFF, not the caller-controlled X-Real-IP value.
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    if ($filaretti_proxy_allowed = 0) { return 403; }
    if ($remote_addr = __TRAEFIK_IP__) { return 400; }

    proxy_http_version 1.1;
    proxy_set_header Host ettorifilaretti.adv.br;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Filaretti-Client-IP "";
    proxy_set_header X-Filaretti-Client-Timestamp "";
    proxy_set_header X-Filaretti-Client-Signature "";
    proxy_read_timeout 60s;
    proxy_buffering off;
    proxy_redirect off;

    location / { proxy_pass http://web:3000; }

    # Nginx error messages cannot redact URIs. Token-bearing flows use only
    # the safe status/method access log and the application's sanitized logs.
    location ~ ^/(api|admin|preview|newsletter)(/|$) {
        error_log /dev/null;
        proxy_pass http://web:3000;
    }
}
